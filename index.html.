<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>DCH Semana 4 | ¿Sancionar o verificar?</title>
<style>
:root{--navy:#102b45;--green:#159447;--lime:#b5d92b;--ink:#203246;--muted:#617286;--line:#dce5eb;--bg:#f3f7f8;--orange:#e58a26;--red:#c74d4d}
*{box-sizing:border-box}body{margin:0;background:var(--bg);font:15px/1.48 system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--ink)}
header{background:linear-gradient(110deg,#0b2944,#15583e);color:#fff;padding:22px max(18px,calc((100% - 1120px)/2));}header .tag{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#cce9d7}h1{font-size:clamp(24px,3vw,34px);margin:5px 0 4px}header p{margin:0;color:#e0eee8}.wrap{max-width:1120px;margin:22px auto;padding:0 16px}.top{display:grid;grid-template-columns:1.6fr 1fr;gap:14px}.panel{background:#fff;border:1px solid var(--line);border-radius:15px;padding:17px;box-shadow:0 4px 16px #17344b0b}.timerrow{display:flex;justify-content:space-between;align-items:center;gap:12px}.timer{font-size:27px;font-weight:800;font-variant-numeric:tabular-nums;color:var(--navy)}.progress{height:9px;background:#e8eef1;border-radius:9px;overflow:hidden;margin-top:12px}.progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--green),var(--lime));transition:width .3s}.dash{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:12px}.metric{background:#f5f8f9;border:1px solid #e7edf0;border-radius:11px;padding:11px}.metric small{display:block;color:var(--muted);font-size:11px;line-height:1.2;min-height:27px}.metric strong{font-size:23px;color:var(--navy)}.metric em{font-style:normal;font-size:11px;color:var(--muted);display:block}.main{display:grid;grid-template-columns:1.55fr .85fr;gap:14px;margin-top:14px}.eyebrow{color:var(--green);font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:.08em}.scenario{background:#f7faf9;border-left:4px solid var(--green);padding:13px 15px;border-radius:8px;margin:12px 0}.question{font-size:19px;font-weight:750;line-height:1.3;margin:14px 0}.choices{display:grid;gap:9px}.choice{border:1.5px solid var(--line);background:#fff;border-radius:11px;padding:12px 13px;text-align:left;color:var(--ink);cursor:pointer;display:grid;grid-template-columns:28px 1fr;gap:10px;align-items:start;transition:.15s}.choice:hover{border-color:#7eb99a;background:#fbfefc}.choice.selected{border-color:var(--green);background:#eff8f2;box-shadow:0 0 0 2px #15944718}.letter{font-weight:800;color:var(--green);background:#e4f3e9;border-radius:7px;text-align:center;padding:3px}.choice:disabled{cursor:default;opacity:.86}.feedback{margin-top:13px;border-radius:10px;padding:13px;background:#f0f5f8;border:1px solid var(--line);display:none}.feedback.show{display:block}.feedback strong{color:var(--navy)}.actions{display:flex;justify-content:space-between;gap:10px;margin-top:15px;flex-wrap:wrap}button.primary,button.secondary{border:0;border-radius:9px;padding:11px 16px;font-weight:750;cursor:pointer}button.primary{background:var(--green);color:#fff}button.secondary{background:#eaf0f3;color:var(--navy)}button:disabled{opacity:.45;cursor:not-allowed}.side h3{margin:0 0 10px;color:var(--navy)}.barrow{margin:12px 0}.barlabel{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:5px}.bar{height:8px;background:#e8eef1;border-radius:8px;overflow:hidden}.bar span{height:100%;display:block;background:var(--green);width:50%;transition:width .3s}.side p{font-size:13px;color:var(--muted)}.note{font-size:12px;color:var(--muted);margin-top:12px}.result{display:none;margin-top:14px}.result.show{display:block}.score{font-size:42px;font-weight:850;color:var(--green)}.resultgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.resultgrid .metric strong{font-size:20px}.footer{font-size:11px;color:#6c7a88;text-align:center;margin:22px 0 12px}.pill{display:inline-block;background:#eaf4ed;color:#17653b;border-radius:20px;padding:4px 9px;font-size:11px;font-weight:750}
@media(max-width:800px){.top,.main{grid-template-columns:1fr}.dash{grid-template-columns:repeat(2,1fr)}.resultgrid{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<header><div class="tag">Desarrollo del Capital Humano · Semana 4</div><h1>¿Sancionar o verificar?</h1><p>Una decisión que compromete a Recursos Humanos</p></header>
<div class="wrap">
<section class="top">
 <div class="panel"><div class="timerrow"><div><div class="eyebrow">Desafío individual · 5 decisiones</div><strong id="stepLabel">Decisión 1 de 5</strong></div><div class="timer" id="timer">06:00</div></div><div class="progress"><span id="progress"></span></div><div class="note">Tiempo de referencia: 6 minutos, como indica la actividad de la sesión. Puedes avanzar a tu ritmo; el cronómetro no bloquea tus respuestas.</div></div>
 <div class="panel"><div class="eyebrow">Panel de control · SIRH</div><div class="dash">
  <div class="metric"><small>Colaboradores</small><strong>100</strong><em>Universo revisado</em></div>
  <div class="metric"><small>Registros verificados</small><strong id="verified">68%</strong><em>68 de 100</em></div>
  <div class="metric"><small>Pendientes de verificación</small><strong id="pending">18%</strong><em>18 registros</em></div>
  <div class="metric"><small>Incompletos / duplicados</small><strong id="errors">14%</strong><em>9 incompletos · 5 duplicados</em></div>
 </div><div class="barrow"><div class="barlabel"><span>Índice inicial de confiabilidad</span><b id="indexText">68/100</b></div><div class="bar"><span id="indexBar" style="width:68%"></span></div></div></div>
</section>
<section class="main" id="playArea">
 <div class="panel"><div class="eyebrow" id="topic">Calidad de la información</div><div class="scenario" id="scenario"></div><div class="question" id="question"></div><div class="choices" id="choices"></div><div class="feedback" id="feedback"></div><div class="actions"><button class="secondary" id="restart">Reiniciar desafío</button><button class="primary" id="next" disabled>Siguiente decisión →</button></div></div>
 <aside class="panel side"><h3>Indicadores de criterio</h3><p>El tablero se modifica según la solidez de tus decisiones. No basta con resolver rápido: importa cómo fundamentas la intervención.</p>
  <div class="barrow"><div class="barlabel"><span>Rigor de la información</span><b id="v1">50</b></div><div class="bar"><span id="b1" style="width:50%"></span></div></div>
  <div class="barrow"><div class="barlabel"><span>Relaciones laborales</span><b id="v2">50</b></div><div class="bar"><span id="b2" style="width:50%"></span></div></div>
  <div class="barrow"><div class="barlabel"><span>Criterio de decisión</span><b id="v3">50</b></div><div class="bar"><span id="b3" style="width:50%"></span></div></div>
  <div class="barrow"><div class="barlabel"><span>Enfoque preventivo</span><b id="v4">50</b></div><div class="bar"><span id="b4" style="width:50%"></span></div></div>
  <p class="note">Los porcentajes son indicadores didácticos del simulador, no mediciones reales de desempeño laboral.</p>
 </aside>
</section>
<section class="panel result" id="result"></section>
<div class="footer">© 2026 Hugo Vázquez. Material académico elaborado a partir de la experiencia docente y los criterios pedagógicos del autor, con apoyo de ChatGPT (OpenAI) en la redacción y el diseño gráfico. Contenido revisado y validado por el autor.</div>
</div>
<script>
const questions=[
{topic:'1 · Lectura crítica del SIRH',scenario:'La dirección solicita sancionar a quienes aparecen con incidencias de asistencia. El tablero muestra 68 registros verificados, 18 pendientes y 14 con datos incompletos o duplicados. El responsable operativo sostiene que el sistema es suficiente para identificar incumplimientos.',q:'¿Cuál es la primera decisión profesionalmente más defendible?',opts:[
['A','Solicitar al área operativa que valide las incidencias y entregue una relación priorizada; RR. HH. revisará los casos con mayor impacto antes de autorizar acciones.'],
['B','Contrastar los registros con fuentes de respaldo, separar incidencias confirmadas de pendientes y errores, y documentar el nivel de confiabilidad antes de decidir.'],
['C','Informar a los colaboradores que existen inconsistencias y abrir un periodo breve de aclaraciones, mientras se conserva el reporte actual como referencia inicial.'],
['D','Analizar primero los patrones por área, turno y frecuencia, para identificar concentraciones atípicas y enfocar la revisión en los segmentos de mayor riesgo.']],best:1,impact:[[4,2,4,3],[3,3,3,3],[2,4,2,2],[3,2,3,4]],fb:[
'La validación operativa aporta contexto, pero delegar la depuración al área involucrada puede dejar sin resolver diferencias de criterio y trazabilidad.',
'Es la alternativa más robusta: distingue información confirmada de datos pendientes o defectuosos. Un SIRH útil debe ofrecer información precisa y completa, no solo disponible.',
'Escuchar aclaraciones favorece la relación laboral, aunque conservar el reporte como referencia sin depurarlo puede sesgar el análisis posterior.',
'Buscar patrones permite priorizar recursos, pero una concentración estadística no confirma por sí misma una incidencia individual.']},
{topic:'2 · Precisión y completitud de datos',scenario:'Durante el contraste aparecen registros duplicados en dos turnos y marcajes faltantes en otro. El área de operaciones propone corregirlos con base en los horarios habituales para cerrar el reporte dentro del día.',q:'¿Qué criterio debe guiar la depuración?',opts:[
['A','Aplicar el horario habitual cuando exista consistencia histórica y dejar identificados esos ajustes para una revisión posterior por muestreo.'],
['B','Solicitar a cada supervisor una confirmación consolidada, pues conoce la operación y puede distinguir rápidamente los casos justificables.'],
['C','Mantener los casos sin respaldo como pendientes, rastrear el origen de duplicados y faltantes, y conservar evidencia de cada corrección autorizada.'],
['D','Corregir únicamente los duplicados evidentes y excluir los marcajes faltantes del cálculo de incidencias hasta contar con información adicional.']],best:2,impact:[[1,1,2,1],[2,2,2,2],[4,2,4,3],[3,2,3,2]],fb:[
'El historial ayuda a detectar anomalías, pero no sustituye la evidencia de una jornada concreta. La rapidez puede introducir errores sistemáticos.',
'El supervisor aporta conocimiento contextual, aunque una confirmación global no garantiza consistencia ni trazabilidad registro por registro.',
'Preserva la integridad del SIRH: no convierte supuestos en hechos y deja una ruta verificable para corregir los datos.',
'Evita algunas imputaciones indebidas, pero excluir datos sin investigar su origen puede ocultar fallas del proceso y mantener incompleto el sistema.']},
{topic:'3 · Relaciones laborales y debido proceso',scenario:'Una colaboradora con varias incidencias aparece en el grupo de registros verificados. Su jefe solicita iniciar una medida disciplinaria; ella sostiene que dos de los días reportados trabajó fuera de las instalaciones y que su autorización fue verbal.',q:'¿Cómo debería proceder RR. HH. antes de recomendar una medida?',opts:[
['A','Pedir al jefe que documente la autorización verbal y recabar la versión de la colaboradora; después, valorar si la evidencia permite continuar el procedimiento.'],
['B','Abrir una revisión formal del caso, comunicar las incidencias concretas, escuchar a la colaboradora y contrastar autorizaciones, registros y términos aplicables.'],
['C','Solicitar a la colaboradora que presente pruebas documentales en un plazo definido y mantener la recomendación disciplinaria en espera de su respuesta.'],
['D','Revisar primero cómo se resolvieron casos similares para asegurar consistencia y, con ese antecedente, determinar qué información adicional se necesita.']],best:1,impact:[[3,3,3,2],[3,4,4,3],[2,2,2,2],[3,3,3,2]],fb:[
'Incorpora ambas versiones, pero depender de que el jefe documente una autorización que él mismo habría concedido puede limitar la imparcialidad de la revisión.',
'Combina comunicación clara, escucha y contraste de evidencia con los términos de la relación de empleo. Evita tratar una alerta del sistema como conclusión automática.',
'La solicitud de pruebas puede ser pertinente, pero trasladar toda la carga a la colaboradora y mantener una recomendación previa puede afectar la percepción de imparcialidad.',
'La consistencia entre casos es importante, aunque los precedentes no sustituyen el análisis de los hechos particulares ni de la evidencia de este caso.']},
{topic:'4 · Diseño de la respuesta de RR. HH.',scenario:'La revisión confirma que parte de las incidencias deriva de errores de captura y de criterios distintos entre supervisores. También se identifican colaboradores que requieren aclaraciones individuales. La dirección pide una solución que reduzca recurrencias sin elevar significativamente los costos.',q:'¿Qué intervención ofrece el mejor equilibrio entre prevención y viabilidad?',opts:[
['A','Estandarizar el registro y la validación por supervisor, establecer responsables y alertas de revisión, y capacitar en el procedimiento con casos prácticos.'],
['B','Adquirir una herramienta de control con validaciones automáticas y reportes por área, financiándola con una reasignación del presupuesto administrativo.'],
['C','Emitir un protocolo actualizado, comunicarlo a toda la plantilla y solicitar a cada jefe un informe mensual de cumplimiento para la dirección.'],
['D','Implementar un piloto en las áreas con mayor incidencia, comparar resultados durante un periodo y extender las medidas que demuestren efectividad.']],best:0,impact:[[4,3,4,4],[3,2,3,3],[2,3,2,3],[3,3,4,4]],fb:[
'Integra proceso, responsabilidades, control y capacitación. Aborda causas operativas sin asumir que la tecnología por sí sola resolverá diferencias de criterio.',
'La automatización puede mejorar consistencia, pero exige inversión y no corrige necesariamente errores de origen ni falta de comprensión del procedimiento.',
'El protocolo ordena expectativas, aunque comunicación e informes periódicos no aseguran que los supervisores hayan desarrollado las competencias necesarias para aplicarlo.',
'El piloto reduce riesgo y permite aprender, aunque necesita criterios de evaluación y responsables claros para que no se convierta en una prueba aislada sin estandarización.']},
{topic:'5 · Decisión y seguimiento',scenario:'La dirección espera una recomendación ejecutiva. Los datos ya depurados permiten distinguir incidencias confirmadas, casos justificados y situaciones que requieren seguimiento. Además, se acordó revisar el procedimiento y reforzar la capacitación de supervisores.',q:'¿Qué debería presentar RR. HH. para cerrar responsablemente el caso?',opts:[
['A','Un listado de incidencias confirmadas y la propuesta de medidas correspondientes, acompañado de una síntesis de las aclaraciones recibidas.'],
['B','Un tablero actualizado con porcentajes por área, comparación con el reporte inicial y metas de reducción para el siguiente periodo.'],
['C','Una recomendación por tipo de caso, sustentada en evidencia y criterios laborales aplicables, junto con responsables, acciones preventivas e indicadores de seguimiento.'],
['D','Un informe de causas principales y un plan de capacitación para supervisores, dejando la revisión de medidas individuales a cada responsable operativo.']],best:2,impact:[[3,2,3,2],[3,2,3,3],[4,4,4,4],[3,2,3,4]],fb:[
'Permite actuar sobre casos confirmados, pero la síntesis puede no mostrar suficientemente los criterios, responsables y controles que evitarán recurrencias.',
'El tablero facilita monitorear tendencias, aunque los porcentajes por sí solos no explican decisiones individuales ni garantizan información relevante y completa.',
'Conecta evidencia, relaciones laborales y mejora del proceso. Además, traduce el análisis en responsabilidades e indicadores verificables.',
'Atiende causas de capacitación, pero separar la revisión individual del acompañamiento de RR. HH. puede producir criterios dispares entre áreas.']}
];
let current=0,answers=[],stats=[50,50,50,50],seconds=360,timerId=null,started=false;
const $=id=>document.getElementById(id);
function render(){let q=questions[current];$('stepLabel').textContent=`Decisión ${current+1} de 5`;$('topic').textContent=q.topic;$('scenario').textContent=q.scenario;$('question').textContent=q.q;$('choices').innerHTML='';$('feedback').className='feedback';$('feedback').innerHTML='';$('next').disabled=true;$('next').textContent=current===4?'Ver resultado final →':'Siguiente decisión →';q.opts.forEach((o,i)=>{let b=document.createElement('button');b.className='choice';b.innerHTML=`<span class="letter">${o[0]}</span><span>${o[1]}</span>`;b.onclick=()=>select(i,b);$('choices').appendChild(b)});$('progress').style.width=(current/5*100)+'%'}
function select(i,button){if(answers[current]!==undefined)return;answers[current]=i;let q=questions[current],good=i===q.best;document.querySelectorAll('.choice').forEach((b,j)=>{b.disabled=true;if(j===i)b.classList.add('selected')});let delta=q.impact[i];stats=stats.map((v,k)=>Math.max(0,Math.min(100,v+delta[k]-1)));updateStats();$('feedback').innerHTML=`<strong>${good?'Decisión más sólida':'Decisión defendible, con una limitación importante'}</strong><br>${q.fb[i]}<br><br><b>Lectura profesional:</b> ${good?'La opción integra mejor los criterios que exige la situación.':'La alternativa atiende una parte del problema, pero deja un riesgo que debe reconocerse y gestionarse.'}`;$('feedback').className='feedback show';$('next').disabled=false;$('progress').style.width=((current+1)/5*100)+'%';}
function updateStats(){['v1','v2','v3','v4'].forEach((id,i)=>{$(id).textContent=stats[i];$('b'+(i+1)).style.width=stats[i]+'%'});let v=Math.round(stats[0]*.35+stats[1]*.25+stats[2]*.25+stats[3]*.15);$('indexText').textContent=v+'/100';$('indexBar').style.width=v+'%';let ver=Math.min(98,68+Math.round((stats[0]-50)*.35));$('verified').textContent=ver+'%';$('pending').textContent=Math.max(2,18-Math.round((stats[0]-50)*.18))+'%';$('errors').textContent=Math.max(2,100-ver-parseInt($('pending').textContent))+'%'}
function next(){if(answers[current]===undefined)return;if(current<4){current++;render()}else finish()}
function finish(){clearInterval(timerId);$('playArea').style.display='none';let avg=Math.round(stats.reduce((a,b)=>a+b,0)/4),correct=answers.filter((a,i)=>a===questions[i].best).length;let level=avg>=82?'Criterio profesional sólido':avg>=68?'Criterio en desarrollo':avg>=55?'Criterio con áreas de mejora':'Se requiere fortalecer el análisis';$('result').className='panel result show';$('result').innerHTML=`<div class="eyebrow">Resultado del desafío</div><div class="score">${avg}/100</div><h2>${level}</h2><p>Identificaste la alternativa más sólida en <b>${correct} de 5 decisiones</b>. El resultado integra rigor de información, relaciones laborales, criterio de decisión y enfoque preventivo; no es una calificación académica automática.</p><div class="resultgrid">${['Rigor de información','Relaciones laborales','Criterio de decisión','Enfoque preventivo'].map((x,i)=>`<div class="metric"><small>${x}</small><strong>${stats[i]}/100</strong></div>`).join('')}</div><h3 style="margin-top:20px">Tu principal aprendizaje</h3><p>Un SIRH no convierte automáticamente un registro en evidencia suficiente. La calidad de la decisión depende de la oportunidad, precisión, concisión, relevancia y completitud de la información, así como de una gestión laboral clara y respetuosa.</p><p><b>Para reflexionar:</b> ¿Qué riesgo asumiría la organización si confundiera una alerta del sistema con una falta laboral comprobada?</p><button class="primary" onclick="location.reload()">Reiniciar desafío</button>`}
function startTimer(){if(started)return;started=true;timerId=setInterval(()=>{seconds--;let m=String(Math.floor(seconds/60)).padStart(2,'0'),s=String(seconds%60).padStart(2,'0');$('timer').textContent=m+':'+s;if(seconds<=0){clearInterval(timerId);$('timer').style.color='var(--red)';$('timer').textContent='00:00'}},1000)}
$('next').onclick=next;$('restart').onclick=()=>location.reload();document.addEventListener('click',e=>{if(e.target.closest('.choice'))startTimer()});render();
</script>
</body></html>
